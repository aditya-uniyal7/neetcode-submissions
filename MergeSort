#include <stdio.h>

void merge(int a[],int l,int m,int r){
    int i,j,k;
    int cap1=m-l+1;
    int cap2=r-m;

    int a1[cap1],a2[cap2];

    for(int i=0;i<cap1;i++){
        a1[i]=a[l+i];
    }
     for(int j=0;j<cap2;j++){
        a2[j]=a[m+j+1];
    }
    i=0,j=0,k=l;
    while(i<cap1 && j<cap2){
    if(a1[i]<=a2[j]){
        a[k]=a1[i];
        i++;
    }
    else{
        a[k]=a2[j];
        j++; 
    }
    k++;
    }
while(i<cap1){
      a[k]=a1[i];
        i++;
        k++;
    }

while(j<cap2){
      a[k]=a2[j];
        j++;
        k++;
}}

void ms(int a[],int l,int r){

    if(l<r){
        int m = (l +r) / 2;
        ms(a,l,m);
        ms(a,m+1,r);
        merge(a,l,m,r);   }

}

int main() {
int arr[]={111,3,6,8};

ms(arr,0,3);
for (int i = 0; i<=3; i++){
    printf("%d ", arr[i]);
}

return 0;


    
